# === Obsidian 自动生成（每台电脑不同，冲突源） ===
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/sync-stats.json

# === 缓存文件（本地生成，无需同步） ===
.obsidian/.obsidian-git-log
.obsidian/cache
.obsidian/hotkeys.json

# === 系统垃圾文件 ===
.DS_Store
Thumbs.db
desktop.ini

# === Obsidian Git 冲突临时文件 ===
*.md.tmp.*
